rules_version = '2';

// Security Rules Firestore — Catalogue Builder
//
// Isolation stricte par utilisateur : chaque personne n'accède qu'à ses
// propres projets sous users/{uid}/projects/{projectId}.
//
// Déploiement :
//   npm i -g firebase-tools   (une fois)
//   firebase login
//   firebase deploy --only firestore:rules
//
// (nécessite un firebase.json pointant sur ce fichier, voir firebase.json)

service cloud.firestore {
  match /databases/{database}/documents {

    // Un user ne lit/écrit que sous son propre uid
    match /users/{uid}/projects/{projectId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // Tout le reste est refusé par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
